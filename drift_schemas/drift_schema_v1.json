  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"subtype\" TEXT NULL, \"parent_id\" TEXT NULL REFERENCES accounts (id), \"currency\" TEXT NOT NULL DEFAULT 'HKD', \"icon\" TEXT NULL, \"color\" INTEGER NULL, \"credit_limit\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"is_system\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "journal_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal_entries\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"occurred_at\" TEXT NOT NULL, \"note\" TEXT NULL, \"merchant\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"external_id\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'posted', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "postings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"postings\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES journal_entries (id) ON DELETE CASCADE, \"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"amount\" INTEGER NOT NULL, \"base_amount\" INTEGER NULL, \"fx_rate\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, \"color\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entry_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entry_tags\" (\"entry_id\" TEXT NOT NULL REFERENCES journal_entries (id) ON DELETE CASCADE, \"tag_id\" TEXT NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"entry_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES journal_entries (id) ON DELETE CASCADE, \"file_path\" TEXT NOT NULL, \"mime_type\" TEXT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"id\" TEXT NOT NULL, \"account_id\" TEXT NULL REFERENCES accounts (id), \"period\" TEXT NOT NULL DEFAULT 'monthly', \"amount\" INTEGER NOT NULL, \"start_month\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"templates\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, \"from_account_id\" TEXT NOT NULL REFERENCES accounts (id), \"to_account_id\" TEXT NOT NULL REFERENCES accounts (id), \"note\" TEXT NULL, \"tag_ids\" TEXT NOT NULL DEFAULT '[]', \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
